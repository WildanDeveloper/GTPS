# WildanDev GTPS nginx example (NOT enabled automatically).
#
# Purpose: expose the Growtopia HTTPS endpoints through the shared nginx on
# 443 without moving the game services off their collision-free ports
# (login 8092, game 17091). Clients point www.growtopia1.com at this server
# via their hosts file.
#
# Install (only when ready to go public):
#   1. Point DNS for a domain you own (example: gtps.example.com) here and
#      issue a real certificate for the growtopia hostnames is impossible
#      (you do not own them), so this block reuses the WildanDev self-signed
#      certificate from resources/certs. Clients must trust it out of band
#      (lab use) or sit behind a GTProxy that terminates TLS.
#   2. cp this file to /etc/nginx/sites-enabled/wildandev-gtps.conf
#   3. nginx -t && systemctl reload nginx

server {
    listen 443 ssl;
    # Enable the IPv6 listener only when the host actually has IPv6, else
    # nginx refuses to start.
    # listen [::]:443 ssl;
    server_name www.growtopia1.com www.growtopia2.com;

    ssl_certificate     /root/WildanDev/resources/certs/server.crt;
    ssl_certificate_key /root/WildanDev/resources/certs/server.key;

    # Growtopia handshake endpoint -> WildanDev login service.
    location = /growtopia/server_data.php {
        proxy_pass https://127.0.0.1:8092;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
    }

    location /player/ {
        proxy_pass https://127.0.0.1:8092;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
    }

    access_log /var/log/nginx/wildandev-gtps-access.log;
    error_log  /var/log/nginx/wildandev-gtps-error.log warn;
}
